+                self.ui_log.warning(f"Part {part_number} "
+                                    f"failed with error {sanitized} "
+                                    f"Attempt {attempt+1} of {max_retries} ")
+                if attempt < max_retries - 1:
+                    backoff = 2 ** attempt
