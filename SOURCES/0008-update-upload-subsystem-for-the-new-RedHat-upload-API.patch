 sos/report/__init__.py         |  13 +
 sos/upload/__init__.py         |  15 +-
 sos/upload/targets/__init__.py |   1 +
 sos/upload/targets/redhat.py   | 584 ++++++++++++++++++++++++++++++++-
 7 files changed, 615 insertions(+), 18 deletions(-)

