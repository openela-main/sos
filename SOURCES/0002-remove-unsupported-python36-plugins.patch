-        transactions_outputs = []
-        for transactional_id in transactional_ids:
-            transactions_describe = self.exec_cmd(
-                (
-                    f"charmed-kafka.transactions {self.default_bin_args}",
-                    f"describe --transactional-id {transactional_id}",
